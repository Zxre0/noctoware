# Build-time pacman.conf template.  scripts/build-iso.sh replaces @FROZEN@,
# @LOCALREPO@ and @ARCHIVE_DATE@ and writes pacman.build.conf.
# Repository order matches the installed system: [noctoware] first, then
# [cachyos] (its NVIDIA modules pin CachyOS' nvidia-utils), then Arch.
[options]
HoldPkg     = pacman glibc
Architecture = x86_64
ParallelDownloads = 8
SigLevel    = Required DatabaseOptional
LocalFileSigLevel = Optional
GPGDir      = @GPGDIR@

[noctoware]
SigLevel = Required DatabaseRequired
Server = file://@LOCALREPO@

[cachyos]
Server = @FROZEN@/cachyos
Server = https://mirror.cachyos.org/repo/$arch/$repo

[core]
Server = @FROZEN@/core
Server = https://geo.mirror.pkgbuild.com/$repo/os/$arch
Server = https://archive.archlinux.org/repos/@ARCHIVE_DATE@/$repo/os/$arch

[extra]
Server = @FROZEN@/extra
Server = https://geo.mirror.pkgbuild.com/$repo/os/$arch
Server = https://archive.archlinux.org/repos/@ARCHIVE_DATE@/$repo/os/$arch

[multilib]
Server = @FROZEN@/multilib
Server = https://geo.mirror.pkgbuild.com/$repo/os/$arch
Server = https://archive.archlinux.org/repos/@ARCHIVE_DATE@/$repo/os/$arch
