#!/usr/bin/env bash
# Entry point of the "Noctoware Hyprland" SDDM session.
# 1. give this session its own ~/.config/kdeglobals (HyDE and Plasma both own it)
# 2. if HyDE is the active shell: deploy/refresh it (no-op when current);
#    with another shell (Revo, via noctoware-shell) never touch its files and
#    drop HyDE's config pointer that uwsm may have left in the systemd user
#    environment from an earlier HyDE session
# 3. hand over to uwsm-managed Hyprland
/usr/lib/noctoware/kdeglobals-swap hyprland || true

shell="$(cat "${XDG_DATA_HOME:-$HOME/.local/share}/noctoware/shells/active" 2>/dev/null || echo hyde)"
if [[ "$shell" == hyde ]]; then
    if ! /usr/bin/noctoware-hyde-deploy --quiet; then
        logger -t noctoware-session "HyDE deployment reported an error; starting Hyprland anyway"
    fi
else
    systemctl --user unset-environment HYPRLAND_CONFIG 2>/dev/null || true
    unset HYPRLAND_CONFIG
fi

if command -v uwsm >/dev/null; then
    exec uwsm start -e -D Hyprland hyprland.desktop
fi
exec /usr/bin/start-hyprland
