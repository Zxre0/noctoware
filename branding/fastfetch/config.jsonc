// Noctoware Linux system-wide Fastfetch defaults (/etc/xdg/fastfetch/config.jsonc).
// Every value below is detected at runtime; nothing about the hardware is hardcoded.
// Users can override with ~/.config/fastfetch/config.jsonc.
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "/usr/share/noctoware/fastfetch/noctoware-ascii.txt",
    "color": { "1": "38;2;155;107;255", "2": "38;2;91;33;182", "3": "38;2;233;221;255" },
    "padding": { "top": 1, "right": 3 }
  },
  "display": {
    "separator": "  ",
    "color": { "keys": "38;2;155;107;255", "title": "38;2;205;180;255" }
  },
  "modules": [
    "title",
    "separator",
    { "type": "os", "key": "OS" },
    { "type": "kernel", "key": "Kernel" },
    { "type": "host", "key": "Host" },
    { "type": "uptime", "key": "Uptime" },
    { "type": "packages", "key": "Packages" },
    { "type": "shell", "key": "Shell" },
    { "type": "de", "key": "Desktop" },
    { "type": "wm", "key": "Compositor" },
    { "type": "display", "key": "Display" },
    { "type": "terminal", "key": "Terminal" },
    { "type": "cpu", "key": "CPU" },
    { "type": "gpu", "key": "GPU" },
    { "type": "memory", "key": "Memory" },
    { "type": "swap", "key": "Swap" },
    { "type": "disk", "key": "Disk" },
    { "type": "battery", "key": "Battery" },
    { "type": "locale", "key": "Locale" },
    "break",
    "colors"
  ]
}
