#!/bin/bash
# Runs inside the target as the last step.
set -uo pipefail
# SDDM: preselect "Noctoware Hyprland" for the first login (users can pick
# Plasma (Wayland) or another session from the menu; SDDM remembers it).
install -d -o sddm -g sddm /var/lib/sddm 2>/dev/null || install -d /var/lib/sddm
cat >/var/lib/sddm/state.conf <<STATE
[Last]
Session=/usr/share/wayland-sessions/noctoware-hyprland.desktop
STATE
chown sddm:sddm /var/lib/sddm/state.conf 2>/dev/null || true

# Btrfs snapshots + pacman pre/post hooks (snap-pac)
if [[ "$(findmnt -no FSTYPE /)" == btrfs ]]; then
    noctoware-snapper-setup || echo "snapper setup failed; see docs/RECOVERY.md"
    # first snapshot = the freshly installed system
    snapper --no-dbus -c root create -d "Noctoware fresh install" -c number --userdata important=yes 2>/dev/null || true
fi

# BIOS + GPT: Calamares' "boot" flag gives the root partition the EFI System
# type GUID; give it the Linux filesystem type (the bios_grub partition is
# what GRUB uses on BIOS/GPT).
if [[ ! -d /sys/firmware/efi ]]; then
    src="$(findmnt -no SOURCE / | sed 's/\[.*//')"
    part="$(basename "$(readlink -f "$src")")"
    disk="$(lsblk -no PKNAME "/dev/$part" 2>/dev/null | head -1)"
    num="$(cat "/sys/class/block/$part/partition" 2>/dev/null)"
    if [[ -n "$disk" && -n "$num" ]] && [[ "$(lsblk -no PARTTYPE "/dev/$part")" == c12a7328-f81f-11d2-ba4b-00a0c93ec93b ]] \
       && [[ "$(lsblk -no FSTYPE "/dev/$part")" != vfat ]]; then
        sgdisk -t "$num:8300" "/dev/$disk" >/dev/null && echo "root partition type set to Linux filesystem"
    fi
fi

# BIOS: brand GRUB and make linux-cachyos (not the LTS recovery kernel) the
# default entry, then regenerate grub.cfg with the non-sparse boot images.
if [[ ! -d /sys/firmware/efi && -f /etc/default/grub ]]; then
    sed -i 's/^GRUB_DISTRIBUTOR=.*/GRUB_DISTRIBUTOR="Noctoware"/' /etc/default/grub
    grep -q '^GRUB_TOP_LEVEL=' /etc/default/grub ||
        echo 'GRUB_TOP_LEVEL="/boot/vmlinuz-linux-cachyos"' >>/etc/default/grub
    /usr/lib/noctoware/noctoware-unsparse-boot
    grub-mkconfig -o /boot/grub/grub.cfg
fi

# make sure the locale chosen in the installer is generated
locale-gen >/dev/null 2>&1 || true
exit 0
