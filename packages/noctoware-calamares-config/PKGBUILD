# Maintainer: Noctoware Project
# Installer configuration.  Lives in /usr/share/noctoware/calamares (passed to
# `calamares -c`), so it never conflicts with files owned by cachyos-calamares.
# Only installed on the live ISO; removed from the target during installation.
pkgname=noctoware-calamares-config
pkgver=0.1
pkgrel=7
pkgdesc="Noctoware Linux Calamares installer configuration and branding"
arch=('any')
url="https://github.com/Zxre0/noctoware"
license=('MIT' 'CC-BY-SA-4.0')
depends=('calamares' 'noctoware-system' 'arch-install-scripts' 'sudo')

package() {
  local root c; root="$(realpath "$startdir/../..")"; c="$root/calamares"
  local dest="$pkgdir/usr/share/noctoware/calamares"
  install -d "$dest"
  install -m644 "$c/settings.conf" "$dest/settings.conf"
  cp -r "$c/modules" "$c/modules-local" "$c/branding" "$dest/"
  install -d "$dest/scripts"
  install -m755 "$c"/scripts/* "$dest/scripts/"
  find "$dest" -type d -exec chmod 755 {} +
  # `calamares -c DIR` also looks for qml/ inside DIR
  ln -s /usr/share/calamares/qml "$dest/qml"
  install -Dm755 "$root/desktop/installer/noctoware-installer" "$pkgdir/usr/bin/noctoware-installer"
  install -Dm644 "$root/desktop/installer/noctoware-installer.desktop" \
    "$pkgdir/usr/share/applications/noctoware-installer.desktop"
}
