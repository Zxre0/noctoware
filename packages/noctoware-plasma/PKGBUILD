# Maintainer: Noctoware Project
#
# KDE Plasma 6 as an ADDITIONAL Noctoware desktop.  Hyprland + HyDE stay
# installed (dependency on noctoware-desktop) and SDDM remains the only display
# manager: this is plasma-meta's component list WITHOUT plasma-login-manager.
# scripts/check-dependencies.sh fails if plasma-meta gains components this list
# lacks, so the two stay in sync.
#
# Install later with:  sudo pacman -S noctoware-plasma
# then log out and pick "Plasma (Wayland)" in SDDM.
pkgname=noctoware-plasma
pkgver=0.1
pkgrel=2
pkgdesc="KDE Plasma 6 (Wayland) as an optional Noctoware desktop, with Noctoware branding"
arch=('any')
url="https://github.com/noctoware/noctoware"
license=('MIT')
_plasma=(
  aurorae bluedevil breeze breeze-gtk discover drkonqi flatpak-kcm kactivitymanagerd
  kde-cli-tools kde-gtk-config kdecoration kdeplasma-addons kglobalacceld kinfocenter
  kmenuedit knighttime kpipewire krdp kscreen kscreenlocker ksshaskpass ksystemstats
  kwallet-pam kwayland kwin kwrited layer-shell-qt libkscreen libksysguard libplasma
  kup milou ocean-sound-theme oxygen oxygen-sounds plasma-activities plasma-activities-stats
  plasma-browser-integration plasma-desktop plasma-disks plasma-firewall plasma-integration
  plasma-keyboard plasma-nm plasma-pa plasma-systemmonitor plasma-thunderbolt plasma-vault
  plasma-welcome plasma-workspace polkit-kde-agent powerdevil print-manager spectacle
  systemsettings union xdg-desktop-portal-kde
)
_apps=(konsole dolphin ark kate gwenview okular kcalc filelight partitionmanager
       kdegraphics-thumbnailers ffmpegthumbs kwalletmanager sddm-kcm)
depends=('noctoware-desktop' 'noctoware-branding' 'sddm' "${_plasma[@]}" "${_apps[@]}")
# deepin-kwin and cachyos-handheld also ship /etc/xdg/kdeglobals.
conflicts=('plasma-login-manager' 'deepin-kwin' 'cachyos-handheld')

package() {
  local d; d="$(realpath "$startdir/../../desktop/plasma")"
  install -Dm644 "$d/Noctoware.colors" "$pkgdir/usr/share/color-schemes/Noctoware.colors"
  install -d "$pkgdir/usr/share/plasma/look-and-feel"
  cp -r "$d/lookandfeel" "$pkgdir/usr/share/plasma/look-and-feel/org.noctoware.desktop"
  install -Dm644 "$d/konsole/Noctoware.profile" "$pkgdir/usr/share/konsole/Noctoware.profile"
  install -Dm644 "$d/konsole/Noctoware.colorscheme" "$pkgdir/usr/share/konsole/Noctoware.colorscheme"
  # System-wide defaults in /etc/xdg are the lowest-priority config layer:
  # nothing here can overwrite what a user has customised in ~/.config.
  install -Dm644 "$d/xdg/kdeglobals" "$pkgdir/etc/xdg/kdeglobals"
  install -Dm644 "$d/xdg/kscreenlockerrc" "$pkgdir/etc/xdg/kscreenlockerrc"
  install -Dm644 "$d/xdg/konsolerc" "$pkgdir/etc/xdg/konsolerc"
  install -Dm755 "$d/xdg/plasma-workspace/env/10-noctoware-kdeglobals.sh" \
    "$pkgdir/etc/xdg/plasma-workspace/env/10-noctoware-kdeglobals.sh"
}
