# Maintainer: Noctoware Project
# Steam and the gaming stack.  GPU-specific Vulkan drivers (including the
# 32-bit ones Steam needs) are chosen per machine by noctoware-gpu.
pkgname=noctoware-gaming
pkgver=0.1
pkgrel=1
pkgdesc="Noctoware Linux gaming stack: Steam, Gamescope, GameMode, MangoHud"
arch=('any')
url="https://github.com/noctoware/noctoware"
license=('MIT')
depends=('steam' 'gamescope' 'gamemode' 'lib32-gamemode' 'mangohud' 'lib32-mangohud'
         'vulkan-icd-loader' 'lib32-vulkan-icd-loader' 'vulkan-tools'
         'lib32-pipewire' 'lib32-libpulse' 'ttf-liberation' 'xdg-desktop-portal')
optdepends=('protontricks: manage per-game Proton prefixes'
            'umu-launcher: run non-Steam games with Proton'
            'wine: run Windows applications outside Steam')
